<UserControl x:Class="CadLens.Preview.ModeLayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="12" Foreground="#EEF5F8" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary Source="ModePreviewTheme.xaml" />
    </UserControl.Resources>
    <Grid Background="#10171E">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Padding="12,9,12,9" BorderBrush="#26373F" BorderThickness="0,0,0,1">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203C3C" Offset="0" /><GradientStop Color="#15212C" Offset="1" /></LinearGradientBrush></Border.Background>
            <StackPanel>
                <DockPanel Margin="1,0,1,8">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpaceLabel}" Foreground="{StaticResource QuietMuted}" FontSize="11"
                               VerticalAlignment="Center" MaxWidth="170" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceLabel}" />
                    <TextBlock Text="{Binding LensLabel}" FontSize="17" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="↻" Width="28" Padding="0" Style="{StaticResource ModeButton}"
                            Command="{Binding ReadCommand}" ToolTip="Refresh active space" AutomationProperties.Name="Refresh active space" />
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}" Style="{StaticResource ModeToggle}" Margin="0,0,5,0" Padding="6,4" FontSize="11"
                                              ToolTip="{Binding Descriptor.Description}" AutomationProperties.Name="{Binding Descriptor.Label}"
                                              Command="{Binding DataContext.ToggleFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,4,0">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="□" /><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Text" Value="✓" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Descriptor.Label}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,7">
                <DockPanel Margin="1,2">
                    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding HasCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DockPanel.Style>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectCount, StringFormat={}{0:N0} objects}" Foreground="{StaticResource QuietMuted}" FontSize="11" />
                    <TextBlock Text="{Binding GroupCount, StringFormat={}{0:N0} layers}" FontSize="11" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel Visibility="{Binding HasCurrent, Converter={StaticResource BooleanVisibility}}">
                    <Button x:Name="BackAction" DockPanel.Dock="Left" Width="30" Height="30" Padding="0" Margin="0,0,5,0"
                            Command="{Binding BackCommand}" Style="{StaticResource ModeButton}" ToolTip="Back" AutomationProperties.Name="Back">
                        <Path Data="M 7,1 L 1,6 L 7,11 M 1,6 L 13,6" Width="14" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button DockPanel.Dock="Left" Content="All layers" Command="{Binding RootCommand}" Style="{StaticResource ModeButton}" Padding="7,4" Height="30" Margin="0,0,5,0" />
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Style="{StaticResource ModeButton}" Padding="5,4" Margin="0,0,3,0" FontSize="11" ToolTip="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Background="#182730" BorderBrush="#34434B" BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,0,0,6">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasCurrent}" Value="True" /><Condition Binding="{Binding IsObject}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding Current.Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current.Label}" />
                        <TextBlock Text="{Binding Current.Count, StringFormat={}{0:N0} objects}" Foreground="{StaticResource QuietAccent}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Margin="2,8" Foreground="{StaticResource QuietMuted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding IsObject}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ModeRow}" Margin="0,0,0,4" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                    Command="{Binding DataContext.EnterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource QuietAccent}" Margin="8,0,0,0" /><TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="{StaticResource QuietMuted}" Margin="8,0,0,0" /><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                    <Border Background="#182730" BorderBrush="#34434B" BorderThickness="1" CornerRadius="5" Padding="9,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Current.Label}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,9" />
                            <ItemsControl ItemsSource="{Binding Current.Fields}">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource QuietMuted}" /><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#141F27" BorderBrush="#34434B" BorderThickness="0,1,0,0" Padding="12,8,12,8">
            <StackPanel>
                <DockPanel Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,7">
                    <Button DockPanel.Dock="Left" Content="‹" Width="28" Padding="0" Style="{StaticResource ModeButton}" Command="{Binding PreviousCommand}" ToolTip="Previous object" AutomationProperties.Name="Previous object" />
                    <Button DockPanel.Dock="Right" Content="›" Width="28" Padding="0" Style="{StaticResource ModeButton}" Command="{Binding NextCommand}" ToolTip="Next object" AutomationProperties.Name="Next object" />
                    <TextBlock Text="{Binding ObjectPosition}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource QuietMuted}" />
                </DockPanel>
                <ContentControl x:Name="ActionPanel" HorizontalContentAlignment="Stretch" />
                <DockPanel Margin="0,7,0,0">
                    <Button x:Name="ResetAction" DockPanel.Dock="Left" Content="Reset" Style="{StaticResource ModeButton}" Command="{Binding ResetCommand}" Padding="10,4"
                            ToolTip="Clear CAD selection and temporary highlight, turn off all Auto modes, and keep the camera." AutomationProperties.Name="Reset selection, highlight, and Auto modes" />
                    <TextBlock Text="Auto off · camera kept" FontSize="10" Foreground="{StaticResource QuietMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Height="28" Margin="1,4,1,0" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ADC0C9" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Foreground" Value="{StaticResource QuietAccent}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
