<UserControl x:Class="CadLens.Preview.ModeActionRows"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="ModePreviewTheme.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="4" /><RowDefinition Height="28" /><RowDefinition Height="4" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Button x:Name="FocusAction" Style="{StaticResource ModeButton}" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"
                Command="{Binding FocusCommand}" AutomationProperties.Name="Focus camera"
                ToolTip="Fit the current layer, type, or object in the active view. Changes the camera only; hidden objects stay hidden.">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="Camera" Style="{StaticResource ModeDescriptor}" /><TextBlock Text="Focus" /></DockPanel>
        </Button>
        <ToggleButton x:Name="AutoFocus" Grid.Column="1" Style="{StaticResource ModeAuto}"
                      IsChecked="{Binding IsAutoFocus, Mode=OneWay}" Command="{Binding ToggleAutoFocusCommand}"
                      AutomationProperties.Name="Auto Focus" ToolTip="Automatically fit the camera when browsing layers, types, and objects." />
        <Button x:Name="SelectAction" Grid.Row="2" Style="{StaticResource ModeButton}" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"
                Command="{Binding SelectCommand}" AutomationProperties.Name="Select CAD objects"
                ToolTip="Select the current layer, type, or object in CAD. Keep the camera and temporary isolation unchanged.">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="CAD selection" Style="{StaticResource ModeDescriptor}" /><TextBlock Text="Select" /></DockPanel>
        </Button>
        <ToggleButton x:Name="AutoSelect" Grid.Row="2" Grid.Column="1" Style="{StaticResource ModeAuto}"
                      IsChecked="{Binding IsAutoSelect, Mode=OneWay}" Command="{Binding ToggleAutoSelectCommand}"
                      AutomationProperties.Name="Auto Select" ToolTip="Automatically select CAD objects while browsing. Works with Auto Focus off." />
        <Button x:Name="IsolateAction" Grid.Row="4" Style="{StaticResource ModeButton}" Margin="0,0,6,0" HorizontalContentAlignment="Stretch"
                Command="{Binding IsolateCommand}" AutomationProperties.Name="Isolate temporarily"
                ToolTip="Temporarily hide other active-space objects. Keep the camera and CAD selection unchanged.">
            <DockPanel><TextBlock DockPanel.Dock="Right" Text="Temporary" Style="{StaticResource ModeDescriptor}" /><TextBlock Text="Isolate" /></DockPanel>
        </Button>
        <ToggleButton x:Name="AutoIsolation" Grid.Row="4" Grid.Column="1" Style="{StaticResource ModeAuto}"
                      IsChecked="{Binding IsAutoIsolation, Mode=OneWay}" Command="{Binding ToggleAutoIsolationCommand}"
                      AutomationProperties.Name="Auto Isolate" ToolTip="Automatically hide other active-space objects while browsing. Turning this off restores their display." />
    </Grid>
</UserControl>
