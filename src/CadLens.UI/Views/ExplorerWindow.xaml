<Window x:Class="CadLens.UI.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CadLens.UI"
        d:DataContext="{d:DesignInstance local:ExplorerViewModel}" mc:Ignorable="d"
        Title="CAD Lens" Width="370" Height="52" MinWidth="300" MinHeight="52"
        Background="#10171E" Foreground="#EEF5F8" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <SolidColorBrush x:Key="Accent" Color="#78E3CE" />
            <Style x:Key="QuietButton" TargetType="ui:Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#34434B" />
                <Setter Property="Foreground" Value="#B6C7CE" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#23333D" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Border Background="#10171E" BorderBrush="#3B5059" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CAD LENS" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Foreground="#9EB5BE" />
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" MaxHeight="48">
                    <ItemsControl ItemsSource="{Binding Lenses}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleLensCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" Margin="0,0,4,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,6"
                                              AutomationProperties.Name="{Binding Descriptor.Label}" ToolTip="{Binding Descriptor.Label}"
                                              ToolTipService.ShowOnDisabled="True" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Foreground" Value="#B6C7CE" />
                                            <Setter Property="Background" Value="#18232C" />
                                            <Setter Property="BorderBrush" Value="#34434B" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Surface" Property="Background" Value="#23333D" />
                                                            </Trigger>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Surface" Property="Background" Value="#28413F" />
                                                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF" />
                                                                <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                    <TextBlock Text="{Binding Descriptor.Label}" VerticalAlignment="Center" />
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="i" />
                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCleanupPending}" Value="True">
                                    <Setter Property="Text" Value="…" />
                                    <Setter Property="Foreground" Value="#E9C46A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:Button Grid.Column="3" Content="×" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource QuietButton}" BorderThickness="0" Padding="8,0"
                           Click="CloseClicked" AutomationProperties.Name="Close CAD Lens" ToolTip="Close"
                           WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding ActiveView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Visibility="{Binding IsLensActive, Converter={StaticResource BooleanVisibility}}" />
        </Grid>
    </Border>
</Window>