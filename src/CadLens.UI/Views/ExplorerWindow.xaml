<Window x:Class="CadLens.UI.ExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CadLens.UI"
             FontFamily="Segoe UI" Foreground="#EEF5F8" Background="#10171E"
             Title="CAD Lens" Width="300" Height="52" MinWidth="300" MinHeight="52"
             WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:QuietTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#3B5059" BorderThickness="1" CornerRadius="12" Background="#10171E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="11,11,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#18232C" Offset="0" />
                        <GradientStop Color="#10171E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Border Width="4" Height="20" Background="#78E3CE" CornerRadius="2" Margin="0,0,9,0" />
                        <TextBlock Text="CAD Lens" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center" MaxHeight="48">
                    <ItemsControl ItemsSource="{Binding Lenses}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Descriptor.Label}" Style="{StaticResource QuietToggle}"
                                              IsChecked="{Binding IsActive, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleLensCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" AutomationProperties.Name="{Binding Descriptor.Label}"
                                              AutomationProperties.HelpText="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTip="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                              ToolTipService.ShowOnDisabled="True" Padding="12,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="2" Content="×" FontSize="18" Style="{StaticResource QuietButton}"
                            Width="30" Height="30" Padding="0" Click="CloseClicked" ToolTip="Close CAD Lens"
                            AutomationProperties.Name="Close CAD Lens" WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>
            <ContentControl Grid.Row="1" Content="{Binding ActiveView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                            Visibility="{Binding IsLensActive, Converter={StaticResource BooleanVisibility}}" />
        </Grid>
    </Border>
</Window>
