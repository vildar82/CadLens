<Window
    Title="CAD Lens"
    x:Class="CadLens.UI.ExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CadLens.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="340"
    Height="52"
    MinWidth="300"
    MinHeight="52"
    d:DataContext="{d:DesignInstance Type=local:ExplorerViewModel}"
    Background="{DynamicResource QuietBackground}"
    FontFamily="Segoe UI"
    Foreground="{DynamicResource QuietText}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:QuietTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="50"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Border
        Background="{DynamicResource QuietBackground}"
        BorderBrush="{DynamicResource QuietBorder}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="11,11,0,0">
                <Border.Background>
                    <DynamicResource ResourceKey="QuietHeader" />
                </Border.Background>
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="3"
                            Height="20"
                            Margin="0,0,6,0"
                            Background="{DynamicResource QuietAccent}"
                            CornerRadius="2" />
                        <ToggleButton
                            x:Name="AboutButton"
                            MinHeight="28"
                            Padding="2,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{local:Localize 'About CAD Lens'}"
                            Background="Transparent"
                            BorderThickness="0"
                            IsChecked="{Binding IsOpen, ElementName=AboutPopup, Mode=TwoWay}"
                            Style="{StaticResource QuietToggle}"
                            ToolTip="{local:Localize 'About CAD Lens'}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="CAD Lens" />
                        </ToggleButton>
                        <Popup
                            x:Name="AboutPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=AboutButton}"
                            StaysOpen="False">
                            <Border
                                Width="280"
                                Margin="0,5,0,0"
                                Padding="12"
                                Background="{DynamicResource QuietBackground}"
                                BorderBrush="{DynamicResource QuietBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                TextElement.Foreground="{DynamicResource QuietText}">
                                <StackPanel>
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        Orientation="Horizontal">
                                        <Image
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,8,0"
                                            Source="/CadLens.UI;component/Resources/CadLens.png" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{local:Localize 'About CAD Lens'}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        Text="{local:Localize 'Explore drawing objects by layer or type in AutoCAD and Civil 3D.'}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Margin="0,0,0,8">
                                        <Hyperlink
                                            x:Name="ProjectLink"
                                            Foreground="{DynamicResource QuietAccent}"
                                            NavigateUri="https://github.com/vildar82/CadLens"
                                            RequestNavigate="ProjectLinkRequested">
                                            <Run Text="github.com/vildar82/CadLens" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock>
                                        <Hyperlink
                                            x:Name="IssuesLink"
                                            Foreground="{DynamicResource QuietAccent}"
                                            NavigateUri="https://github.com/vildar82/CadLens/issues"
                                            RequestNavigate="ProjectLinkRequested">
                                            <Run Text="{local:Localize 'Questions and suggestions'}" />
                                        </Hyperlink>
                                    </TextBlock>
                                    <TextBlock
                                        x:Name="AboutLinkStatus"
                                        Margin="0,8,0,0"
                                        Foreground="{DynamicResource QuietMuted}"
                                        Text="{local:Localize 'Unable to open the browser. Open the project link manually.'}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup
                            x:Name="AppearancePopup"
                            AllowsTransparency="True"
                            DataContext="{Binding Appearance, RelativeSource={RelativeSource AncestorType=Window}}"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=AppearanceButton}"
                            StaysOpen="False">
                            <Border
                                Width="244"
                                Margin="0,5,0,0"
                                Padding="12"
                                Background="{DynamicResource QuietBackground}"
                                BorderBrush="{DynamicResource QuietBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                TextElement.Foreground="{DynamicResource QuietText}">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource AppearanceLabel}" />
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Foreground="{DynamicResource QuietMuted}"
                                        Text="{DynamicResource ThemeLabel}" />
                                    <ComboBox
                                        x:Name="ThemeChoice"
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="{DynamicResource ThemeLabel}"
                                        SelectedValue="{Binding Theme}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem
                                            Content="{DynamicResource FollowAutoCadLabel}"
                                            Tag="Follow AutoCAD" />
                                        <ComboBoxItem Content="{DynamicResource LightLabel}" Tag="Light" />
                                        <ComboBoxItem Content="{DynamicResource DarkLabel}" Tag="Dark" />
                                    </ComboBox>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Foreground="{DynamicResource QuietMuted}"
                                        Text="{DynamicResource PaletteLabel}" />
                                    <ComboBox
                                        x:Name="PaletteChoice"
                                        Margin="0,0,0,10"
                                        AutomationProperties.Name="{DynamicResource PaletteLabel}"
                                        SelectedValue="{Binding Palette}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource QuietLabel}" Tag="Quiet" />
                                        <ComboBoxItem Content="{DynamicResource GraphiteLabel}" Tag="Graphite" />
                                        <ComboBoxItem Content="{DynamicResource PaperLabel}" Tag="Paper" />
                                    </ComboBox>
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        Foreground="{DynamicResource QuietMuted}"
                                        Text="{DynamicResource AccentLabel}" />
                                    <ComboBox
                                        x:Name="AccentChoice"
                                        Margin="0,0,0,12"
                                        AutomationProperties.Name="{DynamicResource AccentLabel}"
                                        SelectedValue="{Binding Accent}"
                                        SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{DynamicResource MintLabel}" Tag="Mint" />
                                        <ComboBoxItem Content="{DynamicResource BlueLabel}" Tag="Blue" />
                                        <ComboBoxItem Content="{DynamicResource VioletLabel}" Tag="Violet" />
                                        <ComboBoxItem Content="{DynamicResource AmberLabel}" Tag="Amber" />
                                    </ComboBox>
                                    <Button
                                        Click="RestoreAppearanceClicked"
                                        Content="{DynamicResource RestoreDefaultsLabel}"
                                        Style="{StaticResource QuietButton}" />
                                    <TextBlock
                                        Margin="0,9,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource QuietMuted}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter
                                                    Property="Text"
                                                    Value="{DynamicResource AppearanceChangesApplied}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaveFailed}" Value="True">
                                                        <Setter
                                                            Property="Text"
                                                            Value="{DynamicResource AppearanceSaveFailed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <ScrollViewer
                        Grid.Column="1"
                        MaxHeight="48"
                        VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Lenses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LensOption}">
                                    <ToggleButton
                                        Padding="5,6"
                                        AutomationProperties.HelpText="{Binding DataContext.Status,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{local:Localize Binding={Binding Descriptor.Label}}"
                                        Command="{Binding DataContext.ToggleLensCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{local:Localize Binding={Binding Descriptor.Label}}"
                                        IsChecked="{Binding IsActive, Mode=OneWay}"
                                        Style="{StaticResource QuietToggle}">
                                        <ToggleButton.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{local:Localize Binding={Binding Descriptor.Label}}" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        Text="{local:Localize Binding={Binding Descriptor.Description}}" />
                                                    <TextBlock
                                                        Margin="0,8,0,0"
                                                        Foreground="{DynamicResource QuietMuted}"
                                                        Text="{Binding PlacementTarget.(AutomationProperties.HelpText),
                                                            RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                                </StackPanel>
                                            </ToolTip>
                                        </ToggleButton.ToolTip>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ToggleButton
                        x:Name="AppearanceButton"
                        Grid.Column="2"
                        Width="26"
                        Height="28"
                        MinHeight="28"
                        Margin="5,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{DynamicResource AppearanceLabel}"
                        Content="⚙"
                        FontSize="15"
                        IsChecked="{Binding IsOpen, ElementName=AppearancePopup, Mode=TwoWay}"
                        Style="{StaticResource QuietToggle}"
                        ToolTip="{DynamicResource AppearanceHelp}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button
                        x:Name="LanguageButton"
                        Grid.Column="3"
                        Width="32"
                        Height="30"
                        Margin="4,0,4,0"
                        Padding="0"
                        AutomationProperties.Name="{local:Localize 'Language'}"
                        Click="LanguageClicked"
                        Content="{Binding LanguageCode, Source={x:Static local:UiText.Current}}"
                        Style="{StaticResource QuietButton}"
                        ToolTip="{local:Localize 'Language'}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu
                                Background="{DynamicResource QuietSurface}"
                                Foreground="{DynamicResource QuietText}">
                                <MenuItem
                                    Click="LanguageSelected"
                                    Header="{local:Localize 'Use Windows language'}"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsWindowsLanguage,
                                        Source={x:Static local:UiText.Current},
                                        Mode=OneWay}"
                                    Tag="Windows" />
                                <Separator />
                                <MenuItem
                                    Click="LanguageSelected"
                                    Header="English"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsEnglishLanguage,
                                        Source={x:Static local:UiText.Current},
                                        Mode=OneWay}"
                                    Tag="English" />
                                <MenuItem
                                    Click="LanguageSelected"
                                    Header="Русский"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsRussianLanguage,
                                        Source={x:Static local:UiText.Current},
                                        Mode=OneWay}"
                                    Tag="Russian" />
                                <Separator />
                                <MenuItem Header="{Binding PreferenceError,
                                    Source={x:Static local:UiText.Current}}" IsEnabled="False">
                                    <MenuItem.Style>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferenceError,
                                                    Source={x:Static local:UiText.Current}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Width="30"
                        Height="30"
                        Padding="0"
                        AutomationProperties.Name="{local:Localize 'Close CAD Lens'}"
                        Click="CloseClicked"
                        Content="×"
                        FontSize="18"
                        Style="{StaticResource QuietButton}"
                        ToolTip="{local:Localize 'Close CAD Lens'}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>
            <ContentControl
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding ActiveView}"
                Visibility="{Binding IsLensActive, Converter={StaticResource BooleanVisibility}}" />
        </Grid>
    </Border>
</Window>