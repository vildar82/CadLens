<Window
    Title="CAD Lens"
    x:Class="CadLens.UI.ExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:CadLens.UI"
    Width="340"
    Height="52"
    MinWidth="300"
    MinHeight="52"
    Background="#10171E"
    FontFamily="Segoe UI"
    Foreground="#EEF5F8"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStyle="None"
    d:DataContext="{d:DesignInstance Type=local:ExplorerViewModel}"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:QuietTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="50"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Border
        Background="#10171E"
        BorderBrush="#3B5059"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border CornerRadius="11,11,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#18232C" />
                        <GradientStop Offset="1" Color="#10171E" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="4"
                            Height="20"
                            Margin="0,0,9,0"
                            Background="#78E3CE"
                            CornerRadius="2" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="CAD Lens" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Column="1"
                        MaxHeight="48"
                        VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Lenses}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LensOption}">
                                    <ToggleButton
                                        Padding="7,6"
                                        AutomationProperties.HelpText="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{local:Localize Binding={Binding Descriptor.Label}}"
                                        Command="{Binding DataContext.ToggleLensCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{local:Localize Binding={Binding Descriptor.Label}}"
                                        IsChecked="{Binding IsActive, Mode=OneWay}"
                                        Style="{StaticResource QuietToggle}"
                                        ToolTip="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button
                        x:Name="LanguageButton"
                        Grid.Column="2"
                        Width="32"
                        Height="30"
                        Margin="4,0,4,0"
                        Padding="0"
                        AutomationProperties.Name="{local:Localize 'Language'}"
                        Click="LanguageClicked"
                        Content="{Binding LanguageCode, Source={x:Static local:UiText.Current}}"
                        Style="{StaticResource QuietButton}"
                        ToolTip="{local:Localize 'Language'}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource QuietSurface}" Foreground="{DynamicResource QuietText}">
                                <MenuItem
                                    Header="{local:Localize 'Use Windows language'}"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsWindowsLanguage, Source={x:Static local:UiText.Current}, Mode=OneWay}"
                                    Tag="Windows"
                                    Click="LanguageSelected" />
                                <Separator />
                                <MenuItem
                                    Header="English"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsEnglishLanguage, Source={x:Static local:UiText.Current}, Mode=OneWay}"
                                    Tag="English"
                                    Click="LanguageSelected" />
                                <MenuItem
                                    Header="Русский"
                                    IsCheckable="True"
                                    IsChecked="{Binding IsRussianLanguage, Source={x:Static local:UiText.Current}, Mode=OneWay}"
                                    Tag="Russian"
                                    Click="LanguageSelected" />
                                <Separator />
                                <MenuItem IsEnabled="False" Header="{Binding PreferenceError, Source={x:Static local:UiText.Current}}">
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PreferenceError, Source={x:Static local:UiText.Current}}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button
                        Grid.Column="3"
                        Width="30"
                        Height="30"
                        Padding="0"
                        AutomationProperties.Name="{local:Localize 'Close CAD Lens'}"
                        Click="CloseClicked"
                        Content="×"
                        FontSize="18"
                        Style="{StaticResource QuietButton}"
                        ToolTip="{local:Localize 'Close CAD Lens'}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>
            <ContentControl
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding ActiveView}"
                Visibility="{Binding IsLensActive, Converter={StaticResource BooleanVisibility}}" />
        </Grid>
    </Border>
</Window>