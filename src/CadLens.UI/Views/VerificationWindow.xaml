<Window x:Class="CadLens.UI.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:CadLens.UI"
        d:DataContext="{d:DesignInstance local:VerificationViewModel}" mc:Ignorable="d"
        Title="CAD Lens" Width="370" Height="660" MinWidth="300" MinHeight="450"
        Background="#10171E" Foreground="#EEF5F8" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <SolidColorBrush x:Key="Accent" Color="#78E3CE" />
            <Style x:Key="QuietButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#34434B" />
                <Setter Property="Foreground" Value="#B6C7CE" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="#18232C" CornerRadius="7" Margin="0,0,0,5" Padding="12,10">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#23333D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>
    <Border Background="#10171E" BorderBrush="#3B5059" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="20,0,14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M0,7 L10,2 20,7 10,12Z M0,12 L10,17 20,12 M0,17 L10,22 20,17"
                          Stroke="{StaticResource Accent}" StrokeThickness="1.5" Width="22" Height="25" Margin="0,0,10,0" />
                    <TextBlock Text="CAD LENS" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Content="×" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource QuietButton}" BorderThickness="0" Padding="8,0"
                           Click="CloseClicked" AutomationProperties.Name="Close CAD Lens" ToolTip="Close"
                           WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
            <Border Grid.Row="1" Padding="20,14,20,16" BorderBrush="#26373F" BorderThickness="0,1,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#203C3C" Offset="0" />
                        <GradientStop Color="#15212C" Offset="0.75" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <DockPanel Margin="0,0,0,9">
                        <Border DockPanel.Dock="Right" Background="#28413F" CornerRadius="10" Padding="9,3">
                            <TextBlock Text="PREVIEW" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                        </Border>
                        <TextBlock Text="DRAWING EXPLORER" FontSize="10" Foreground="#9BB9BE" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding LensLabel}" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SpaceLabel}" Foreground="#A8C2C7" FontSize="12" Margin="0,2,0,12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding GroupCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="groups" FontSize="11" Foreground="#9EB5BE" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#37505A" Margin="0,5" />
                        <StackPanel Grid.Column="2" Margin="18,0,0,0" Orientation="Horizontal">
                            <TextBlock Text="{Binding ObjectCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="objects" FontSize="11" Foreground="#9EB5BE" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="18,15,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="2,0,0,10">
                    <ui:Button DockPanel.Dock="Right" Content="↻ Refresh" Command="{Binding ReadCommand}"
                               Style="{StaticResource QuietButton}" ToolTip="Read all objects in the active space" />
                    <TextBlock Text="INVENTORY" Foreground="#92A8B3" FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <TextBlock Text="Refresh to explore the active space."
                               TextWrapping="Wrap" Foreground="#879FAA" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGroups}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding HasGroups, Converter={StaticResource BooleanVisibility}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}"
                                               Foreground="#C3D4DA" FontWeight="SemiBold" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"
                                               Foreground="#EDF4F7" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
            <Border Grid.Row="3" Background="#141F27" BorderBrush="#2B3B44" BorderThickness="0,1,0,0" Padding="18,15,18,18">
                <StackPanel>
                    <ui:Button Content="Highlight selection  ↗" Command="{Binding EmphasizeCommand}"
                               Background="{StaticResource Accent}" Foreground="#102B2A" BorderThickness="0"
                               FontWeight="SemiBold" Padding="12,11" HorizontalAlignment="Stretch" Cursor="Hand"
                               ToolTip="Highlight preselected objects and dim other objects. Does not zoom or change layers." />
                    <DockPanel Margin="0,9,0,12">
                        <ui:Button DockPanel.Dock="Right" Content="Clear highlight" Command="{Binding ClearCommand}"
                                   Style="{StaticResource QuietButton}" BorderThickness="0" Padding="4,3" />
                        <TextBlock Text="Temporary · no drawing edits" Foreground="#91A7B2" FontSize="10"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,0,0,9"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibility}}"
                                 AutomationProperties.Name="Waiting for drawing operation" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="#ADC0C9"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>