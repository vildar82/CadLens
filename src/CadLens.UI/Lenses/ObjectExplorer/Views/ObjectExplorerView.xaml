<UserControl
    x:Class="CadLens.UI.ObjectExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lenses="clr-namespace:CadLens.Lenses;assembly=CadLens.Lenses"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:CadLens.UI"
    d:DataContext="{d:DesignInstance Type=ui:ObjectExplorerViewModel}"
    FontFamily="Segoe UI"
    FontSize="12"
    Foreground="{DynamicResource QuietText}"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="ObjectExplorerTheme.xaml" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource QuietBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Padding="12,9,12,9"
            BorderBrush="{DynamicResource QuietBorder}"
            BorderThickness="0,0,0,1">
            <Border.Background>
                <DynamicResource ResourceKey="QuietHeader" />
            </Border.Background>
            <StackPanel>
                <UniformGrid Margin="0,0,0,8" Columns="2">
                    <RadioButton
                        x:Name="AllObjectsScope"
                        Margin="0,0,3,0"
                        Padding="8,5"
                        Command="{Binding ShowAllObjectsCommand}"
                        Content="{ui:Localize 'All objects'}"
                        IsChecked="{Binding IsAllObjects, Mode=OneWay}"
                        Style="{StaticResource ModeScope}"
                        ToolTip="{ui:Localize 'Browse all direct objects in the active drawing space'}" />
                    <RadioButton
                        x:Name="SelectedObjectsScope"
                        Margin="3,0,0,0"
                        Padding="8,5"
                        Command="{Binding ShowSelectedObjectsCommand}"
                        Content="{ui:Localize 'Selected objects'}"
                        IsChecked="{Binding IsSelectedObjectsOnly, Mode=OneWay}"
                        Style="{StaticResource ModeScope}"
                        ToolTip="{ui:Localize 'Use selected CAD objects, or select objects in CAD. Refresh updates the selection scope.'}" />
                </UniformGrid>
                <DockPanel>
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="{ui:Localize Binding={Binding RefreshLabel}}"
                        Command="{Binding ReadCommand}"
                        Content="↻"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ModeButton}"
                        ToolTip="{ui:Localize Binding={Binding RefreshLabel}}" />
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:FilterOption}">
                                <ToggleButton
                                    Margin="0,0,5,0"
                                    Padding="6,4"
                                    AutomationProperties.Name="{ui:Localize Binding={Binding Descriptor.Label}}"
                                    Command="{Binding DataContext.ToggleFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    FontSize="11"
                                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                    Style="{StaticResource ModeToggle}"
                                    ToolTip="{ui:Localize Binding={Binding Descriptor.Description}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="□" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="✓" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{ui:Localize Binding={Binding Descriptor.Label}}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="1,2">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontSize="11"
                        Foreground="{DynamicResource QuietMuted}"
                        Text="{ui:Localize Binding={Binding ObjectCount},
                                           Format='{}{0:N0} objects'}" />
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding GroupSummary}" />
                </DockPanel>
                <DockPanel Grid.Row="0" Visibility="{Binding HasCurrent, Converter={StaticResource BooleanVisibility}}">
                    <Button
                        x:Name="BackAction"
                        Width="30"
                        Height="30"
                        Margin="0,0,5,0"
                        Padding="0"
                        AutomationProperties.Name="{ui:Localize 'Back'}"
                        Command="{Binding BackCommand}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}"
                        ToolTip="{ui:Localize 'Back'}">
                        <Path
                            Width="14"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 7,1 L 1,6 L 7,11 M 1,6 L 13,6"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="0,0,5,0"
                        Padding="7,4"
                        Command="{Binding RootCommand}"
                        Content="{ui:Localize Binding={Binding RootLabel}}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}" />
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type lenses:LensNode}">
                                <Button
                                    Margin="0,0,3,0"
                                    Padding="5,4"
                                    Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    FontSize="11"
                                    Style="{StaticResource ModeButton}"
                                    ToolTip="{ui:DrawingValueFormatter Binding={Binding}}">
                                    <TextBlock Text="{ui:DrawingValueFormatter Binding={Binding}}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <TextBlock
                    x:Name="CurrentLengthTotal"
                    Grid.Row="1"
                    Margin="0"
                    Style="{StaticResource ModeLengthTotal}"
                    Text="{ui:DrawingValueFormatter Binding={Binding Current},
                                                    LengthTotal=True}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{ui:DrawingValueFormatter Binding={Binding Current},
                                                       LengthTotal=True}" />
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6" Visibility="{Binding CanGroup, Converter={StaticResource BooleanVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="54" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton
                        x:Name="GroupingAction"
                        Padding="8,5"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{ui:Localize 'Group by properties'}"
                        FontSize="11"
                        Style="{StaticResource ModeToggle}"
                        ToolTip="{ui:Localize 'Choose properties to combine into one group'}">
                        <DockPanel>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="▾" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource QuietMuted}"
                                    Text="{ui:Localize 'Group by'}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding GroupingSummary}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding GroupingSummary}" />
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="GroupingPopup"
                        Grid.Column="0"
                        AllowsTransparency="True"
                        DataContext="{Binding DataContext, ElementName=GroupingAction}"
                        IsOpen="{Binding IsChecked, ElementName=GroupingAction, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=GroupingAction}"
                        StaysOpen="False">
                        <Border
                            Width="{Binding ActualWidth, ElementName=GroupingAction}"
                            MinWidth="180"
                            MaxHeight="320"
                            Padding="7"
                            Background="{DynamicResource QuietSurface}"
                            BorderBrush="{DynamicResource QuietBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GroupingOptions}" Tag="{Binding ToggleGroupingCommand}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:GroupingOption}">
                                            <CheckBox
                                                Margin="0,0,0,3"
                                                AutomationProperties.Name="{ui:Localize Binding={Binding Label}}"
                                                Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Content="{ui:Localize Binding={Binding Label}}"
                                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                Style="{StaticResource QuietCheckBox}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <ToggleButton
                        x:Name="DisplayPropertyAction"
                        Grid.Column="2"
                        Padding="8,5"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{ui:Localize 'Show property'}"
                        FontSize="11"
                        Style="{StaticResource ModeToggle}"
                        ToolTip="{ui:Localize 'Choose the property shown in object rows'}">
                        <DockPanel>
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Text="▾" />
                            <StackPanel>
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{DynamicResource QuietMuted}"
                                    Text="{ui:Localize 'Show property'}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding DisplayPropertyLabel}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayPropertyLabel}" />
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="DisplayPropertyPopup"
                        Grid.Column="2"
                        AllowsTransparency="True"
                        DataContext="{Binding DataContext, ElementName=DisplayPropertyAction}"
                        IsOpen="{Binding IsChecked, ElementName=DisplayPropertyAction, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=DisplayPropertyAction}"
                        StaysOpen="False">
                        <Border
                            Width="{Binding ActualWidth, ElementName=DisplayPropertyAction}"
                            MinWidth="180"
                            MaxHeight="320"
                            Padding="7"
                            Background="{DynamicResource QuietSurface}"
                            BorderBrush="{DynamicResource QuietBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DisplayPropertyOptions}" Tag="{Binding SelectDisplayPropertyCommand}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type ui:GroupingOption}">
                                            <Button
                                                Margin="0,0,0,3"
                                                Padding="5,4"
                                                AutomationProperties.Name="{ui:Localize Binding={Binding Label}}"
                                                Click="DisplayPropertyClicked"
                                                Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModeRow}">
                                                <DockPanel>
                                                    <TextBlock
                                                        Margin="7,0,0,0"
                                                        VerticalAlignment="Center"
                                                        DockPanel.Dock="Right"
                                                        Foreground="{DynamicResource QuietAccent}"
                                                        Text="✓"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BooleanVisibility}}" />
                                                    <TextBlock VerticalAlignment="Center" Text="{ui:Localize Binding={Binding Label}}" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                    <ToggleButton
                        x:Name="PropertyFilterAction"
                        Grid.Column="4"
                        Padding="4,5"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{ui:Localize 'Filter by property'}"
                        FontSize="11"
                        Style="{StaticResource ModeToggle}"
                        ToolTip="{Binding PropertyFilterSummary}">
                        <StackPanel>
                            <TextBlock
                                FontSize="10"
                                Foreground="{DynamicResource QuietMuted}"
                                Text="{ui:Localize 'Filter'}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{DynamicResource QuietAccent}"
                                Text="{Binding PropertyFilterCount}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup
                        x:Name="PropertyFilterPopup"
                        Grid.Column="4"
                        AllowsTransparency="True"
                        DataContext="{Binding DataContext, ElementName=PropertyFilterAction}"
                        IsOpen="{Binding IsChecked, ElementName=PropertyFilterAction, Mode=TwoWay}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PropertyFilterAction}"
                        StaysOpen="False">
                        <Border
                            Width="{Binding ActualWidth, ElementName=PropertyFilterAction}"
                            MinWidth="250"
                            MaxWidth="360"
                            Padding="10"
                            Background="{DynamicResource QuietSurface}"
                            BorderBrush="{DynamicResource QuietBorder}"
                            BorderThickness="1"
                            CornerRadius="5">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource QuietAccent}"
                                    Text="{Binding PropertyFilterSummary}"
                                    TextWrapping="Wrap" />
                                <TextBlock Margin="0,0,0,4" Text="{ui:Localize 'Property'}" />
                                <ComboBox
                                    x:Name="PropertyFilterProperty"
                                    AutomationProperties.Name="{ui:Localize 'Property'}"
                                    ItemsSource="{Binding PropertyFilter.PropertyOptions}"
                                    SelectedValue="{Binding PropertyFilter.PropertyId}"
                                    SelectedValuePath="Id">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{ui:Localize Binding={Binding Label}}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,4" Text="{ui:Localize 'Comparison'}" />
                                <ComboBox
                                    x:Name="PropertyFilterOperator"
                                    AutomationProperties.Name="{ui:Localize 'Comparison'}"
                                    ItemsSource="{Binding PropertyFilter.OperatorOptions}"
                                    SelectedValue="{Binding PropertyFilter.Operator}"
                                    SelectedValuePath="Value">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock
                                                    Width="18"
                                                    Margin="0,0,7,0"
                                                    DockPanel.Dock="Left"
                                                    Foreground="{DynamicResource QuietAccent}"
                                                    Text="{Binding Symbol}"
                                                    TextAlignment="Center" />
                                                <TextBlock Text="{ui:Localize Binding={Binding Label}}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Margin="0,8,0,4" Text="{ui:Localize 'Value'}" />
                                <TextBox
                                    x:Name="PropertyFilterInput"
                                    AutomationProperties.Name="{ui:Localize 'Value'}"
                                    Text="{Binding PropertyFilter.InputText, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding PropertyFilter.UsesTextInput, Converter={StaticResource BooleanVisibility}}" />
                                <ComboBox
                                    x:Name="PropertyFilterValue"
                                    AutomationProperties.Name="{ui:Localize 'Value'}"
                                    ItemsSource="{Binding PropertyFilter.ValueOptions}"
                                    SelectedValue="{Binding PropertyFilter.SelectedValue}"
                                    SelectedValuePath="Value"
                                    Visibility="{Binding PropertyFilter.UsesValueOptions, Converter={StaticResource BooleanVisibility}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Text="{Binding Label}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="10"
                                    Foreground="{DynamicResource QuietMuted}"
                                    Text="{Binding PropertyFilter.InputHint}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource QuietAccent}"
                                    Text="{Binding PropertyFilter.Error}"
                                    TextWrapping="Wrap" />
                                <UniformGrid Margin="0,8,0,0" Columns="2">
                                    <Button
                                        Margin="0,0,3,0"
                                        Command="{Binding ApplyPropertyFilterCommand}"
                                        Content="{ui:Localize 'Apply'}"
                                        Style="{StaticResource ModeButton}" />
                                    <Button
                                        Margin="3,0,0,0"
                                        Command="{Binding ClearPropertyFilterCommand}"
                                        Content="{ui:Localize 'Clear filter'}"
                                        Style="{StaticResource ModeButton}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,6"
                    Padding="9,7"
                    Background="{DynamicResource QuietSurface}"
                    BorderBrush="{DynamicResource QuietBorder}"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCurrent}" Value="True" />
                                        <Condition Binding="{Binding IsObject}" Value="False" />
                                        <Condition Binding="{Binding CanGroup}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{ui:DrawingValueFormatter Binding={Binding Current}}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{ui:DrawingValueFormatter Binding={Binding Current}}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource QuietAccent}"
                            Text="{ui:Localize Binding={Binding Current.Count,
                                                                FallbackValue=0},
                                               Format='{}{0:N0} objects'}" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObject}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="30"
                        Margin="0,0,0,5"
                        Background="{DynamicResource QuietSurface}"
                        BorderBrush="{DynamicResource QuietBorder}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource QuietAccent}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="8,0,3,0">
                            <Path
                                Width="16"
                                Height="16"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Data="M 8,1 A 7,7 0 1 1 7.99,1 M 13,13 L 19,19"
                                DockPanel.Dock="Left"
                                IsHitTestVisible="False"
                                Stretch="Uniform"
                                Stroke="{DynamicResource QuietMuted}"
                                StrokeThickness="1.5" />
                            <Button
                                Width="23"
                                Height="23"
                                Padding="0"
                                AutomationProperties.Name="{ui:Localize 'Clear search'}"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                DockPanel.Dock="Right"
                                FontSize="14"
                                ToolTip="{ui:Localize 'Clear search'}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource ModeButton}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Grid>
                                <TextBox
                                    Padding="0"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="{ui:Localize Binding={Binding SearchPlaceholder}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CaretBrush="{DynamicResource QuietText}"
                                    Foreground="{DynamicResource QuietText}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource QuietMuted}"
                                    IsHitTestVisible="False"
                                    Text="{ui:Localize Binding={Binding SearchPlaceholder}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <DockPanel Grid.Row="1">
                        <ToggleButton
                            MinWidth="78"
                            AutomationProperties.Name="{Binding SortByCountLabel}"
                            Command="{Binding SortByCountCommand}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsCountSortActive, Mode=OneWay}"
                            Style="{StaticResource ModeSortHeader}"
                            ToolTip="{Binding SortByCountLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SortByCountLabel}" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding CountSortArrow}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="{Binding SortByNameLabel}"
                            Command="{Binding SortByNameCommand}"
                            DockPanel.Dock="Left"
                            IsChecked="{Binding IsNameSortActive, Mode=OneWay}"
                            Style="{StaticResource ModeSortHeader}"
                            ToolTip="{Binding SortByNameLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{ui:Localize 'Name'}" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding NameSortArrow}" />
                            </StackPanel>
                        </ToggleButton>
                    </DockPanel>
                </Grid>
                <TextBlock
                    Grid.Row="3"
                    Margin="2,8"
                    Foreground="{DynamicResource QuietMuted}"
                    Text="{Binding EmptyMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                <ListBox
                    Grid.Row="3"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObject}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type lenses:LensNode}">
                            <Button
                                Margin="0,0,0,4"
                                AutomationProperties.Name="{ui:DrawingValueFormatter Binding={Binding}}"
                                Command="{Binding DataContext.EnterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ModeRow}"
                                ToolTip="{ui:DrawingValueFormatter Binding={Binding}}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Foreground="{DynamicResource QuietAccent}"
                                        Text="›" />
                                    <TextBlock
                                        MaxWidth="120"
                                        MaxHeight="18"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Foreground="{DynamicResource QuietMuted}"
                                        Text="{ui:DrawingValueFormatter Binding={Binding},
                                                                        Metric=True,
                                                                        PropertyBinding={Binding DataContext.DisplayPropertyId,
                                                                                                 RelativeSource={RelativeSource AncestorType=UserControl}}}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{ui:DrawingValueFormatter Binding={Binding},
                                                                           ValueToolTip=True,
                                                                           PropertyBinding={Binding DataContext.DisplayPropertyId,
                                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            MaxHeight="34"
                                            Text="{ui:DrawingValueFormatter Binding={Binding}}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource ModeLengthTotal}" Text="{ui:DrawingValueFormatter Binding={Binding}, LengthTotal=True}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer
                    x:Name="ObjectDetails"
                    Grid.Row="1"
                    Grid.RowSpan="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                    <Border
                        Padding="9,8"
                        Background="{DynamicResource QuietSurface}"
                        BorderBrush="{DynamicResource QuietBorder}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,9"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{ui:DrawingValueFormatter Binding={Binding Current}}"
                                TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Current.Fields, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lenses:DetailField}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource QuietMuted}"
                                                Text="{ui:Localize Binding={Binding Label}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{ui:Localize Binding={Binding},
                                                                   DetailValue=True}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border
            Grid.Row="2"
            Padding="12,8,12,8"
            Background="{DynamicResource QuietDisabledSurface}"
            BorderBrush="{DynamicResource QuietBorder}"
            BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,7" Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="{ui:Localize 'Previous object'}"
                        Command="{Binding PreviousCommand}"
                        Content="‹"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}"
                        ToolTip="{ui:Localize 'Previous object'}" />
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="{ui:Localize 'Next object'}"
                        Command="{Binding NextCommand}"
                        Content="›"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ModeButton}"
                        ToolTip="{ui:Localize 'Next object'}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource QuietMuted}"
                        Text="{Binding ObjectPosition}" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Button
                        AutomationProperties.Name="{ui:Localize 'Focus camera'}"
                        Command="{Binding FocusCommand}"
                        Style="{StaticResource ModeButton}">
                        <Button.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Fit the current layer, type, or object in the active view. Changes the camera only;
                                    hidden objects stay hidden.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </Button.ToolTip>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="{ui:Localize 'Focus'}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="{ui:Localize 'Camera'}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Grid.Row="2"
                        Grid.Column="0"
                        MinHeight="26"
                        AutomationProperties.Name="{ui:Localize 'Auto Focus'}"
                        Command="{Binding ToggleAutoFocusCommand}"
                        IsChecked="{Binding IsAutoFocus, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}">
                        <ToggleButton.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Automatically fit the camera when browsing layers, types, and objects.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        AutomationProperties.Name="{ui:Localize 'Select CAD objects'}"
                        Command="{Binding SelectCommand}"
                        Style="{StaticResource ModeButton}">
                        <Button.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Select the current layer, type, or object in CAD. Keep the camera and temporary
                                    isolation unchanged.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </Button.ToolTip>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="{ui:Localize 'Select'}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="{ui:Localize 'CAD selection'}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Grid.Row="2"
                        Grid.Column="2"
                        MinHeight="26"
                        AutomationProperties.Name="{ui:Localize 'Auto Select'}"
                        Command="{Binding ToggleAutoSelectCommand}"
                        IsChecked="{Binding IsAutoSelect, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}">
                        <ToggleButton.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Automatically select CAD objects while browsing. Works with Auto Focus off.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                    <Button
                        Grid.Row="0"
                        Grid.Column="4"
                        AutomationProperties.Name="{ui:Localize 'Isolate temporarily'}"
                        Command="{Binding IsolateCommand}"
                        Style="{StaticResource ModeButton}">
                        <Button.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Temporarily hide other active-space objects. Keep the camera and CAD selection
                                    unchanged.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </Button.ToolTip>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="{ui:Localize 'Isolate'}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="{ui:Localize 'Temporary'}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="AutoIsolation"
                        Grid.Row="2"
                        Grid.Column="4"
                        MinHeight="26"
                        AutomationProperties.Name="{ui:Localize 'Auto Isolate'}"
                        Command="{Binding ToggleAutoIsolationCommand}"
                        IsChecked="{Binding IsAutoIsolation, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}">
                        <ToggleButton.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Automatically hide other active-space objects while browsing. Turning this off
                                    restores their display.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                </Grid>
                <DockPanel Margin="0,7,0,0">
                    <Button
                        x:Name="ResetAction"
                        Padding="10,4"
                        AutomationProperties.Name="{ui:Localize 'Reset selection, isolation, and Auto modes'}"
                        Command="{Binding ResetCommand}"
                        Content="{ui:Localize 'Reset'}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}">
                        <Button.ToolTip>
                            <ui:Localize>
                                <ui:Localize.Text>
                                    Clear CAD selection and temporary isolation, turn off all Auto modes, and keep the
                                    camera.
                                </ui:Localize.Text>
                            </ui:Localize>
                        </Button.ToolTip>
                    </Button>
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{DynamicResource QuietMuted}"
                        Text="{ui:Localize 'Auto off · camera kept'}" />
                </DockPanel>
                <TextBlock
                    x:Name="StatusText"
                    MinHeight="28"
                    Margin="1,4,1,0"
                    FontSize="11"
                    Text="{Binding Status}"
                    TextWrapping="Wrap"
                    ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource QuietMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource QuietAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>