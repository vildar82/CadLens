<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:CadLens.UI">
    <ResourceDictionary.MergedDictionaries>
        <ui:QuietTheme />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ModeControl" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource QuietText}" />
        <Setter Property="Background" Value="#1B2932" />
        <Setter Property="BorderBrush" Value="#42545E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <Border
                            x:Name="FocusRing"
                            Margin="3"
                            BorderBrush="#FFFFFF"
                            BorderThickness="1"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#2A3C46" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#78E3CE" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#0A151B" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#A0F0E0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#8A9EA7" />
                            <Setter TargetName="Surface" Property="Background" Value="#141F27" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#2B3A43" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ModeButton"
        BasedOn="{StaticResource ModeControl}"
        TargetType="Button" />
    <Style
        x:Key="ModeToggle"
        BasedOn="{StaticResource ModeControl}"
        TargetType="ToggleButton">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#24463F" />
                <Setter Property="BorderBrush" Value="#78E3CE" />
                <Setter Property="Foreground" Value="#A0F0E0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ModeAuto"
        BasedOn="{StaticResource ModeToggle}"
        TargetType="ToggleButton">
        <Setter Property="Content" Value="Auto off" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,3" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="✓ Auto on" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ModeRow"
        BasedOn="{StaticResource ModeButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="33" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="ModeSortHeader"
        BasedOn="{StaticResource ModeControl}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{StaticResource QuietAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModeDescriptor" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>