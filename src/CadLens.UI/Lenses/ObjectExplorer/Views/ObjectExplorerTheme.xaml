<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:CadLens.UI">
    <ResourceDictionary.MergedDictionaries>
        <ui:QuietTheme />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ModeLengthTotal" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource QuietMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModeControl" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource QuietText}" />
        <Setter Property="Background" Value="{DynamicResource QuietSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
                        </Border>
                        <Border
                            x:Name="FocusRing"
                            Margin="3"
                            BorderBrush="{DynamicResource QuietFocus}"
                            BorderThickness="1"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource QuietHover}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource QuietAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource QuietPressed}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource QuietAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource QuietDisabledText}" />
                            <Setter
                                TargetName="Surface"
                                Property="Background"
                                Value="{DynamicResource QuietDisabledSurface}" />
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style
        x:Key="ModeButton"
        BasedOn="{StaticResource ModeControl}"
        TargetType="Button" />
    <Style
        x:Key="ModeToggle"
        BasedOn="{StaticResource ModeControl}"
        TargetType="ToggleButton">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource QuietSelected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource QuietAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource QuietAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ModeScope"
        BasedOn="{StaticResource ModeControl}"
        TargetType="RadioButton">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource QuietSelected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource QuietAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource QuietAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ModeAuto"
        BasedOn="{StaticResource ModeToggle}"
        TargetType="ToggleButton">
        <Setter Property="Content" Value="{ui:Localize 'Auto off'}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,3" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content" Value="{ui:Localize '✓ Auto on'}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ModeRow"
        BasedOn="{StaticResource ModeButton}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="33" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style
        x:Key="ModeSortHeader"
        BasedOn="{StaticResource ModeControl}"
        TargetType="ToggleButton">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="5,2" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource QuietAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModeDescriptor" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>