<UserControl x:Class="CadLens.UI.LayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CadLens.UI"
             FontFamily="Segoe UI" FontSize="13" Foreground="#EEF5F8" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:QuietTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="#10171E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="16,12,16,10" BorderBrush="#26373F" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#203C3C" Offset="0" />
                    <GradientStop Color="#15212C" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SpaceLabel}" Foreground="{StaticResource QuietMuted}"
                               FontSize="11" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceLabel}" />
                    <TextBlock Text="{Binding LensLabel}" FontSize="19" FontWeight="SemiBold" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="↻" Width="32" Padding="0" Style="{StaticResource QuietButton}"
                            Command="{Binding ReadCommand}" ToolTip="Refresh active space" AutomationProperties.Name="Refresh active space" />
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsEnabled, Mode=OneWay}" Style="{StaticResource QuietToggle}"
                                              Margin="0,0,6,0" Padding="8,6" ToolTip="{Binding Descriptor.Description}"
                                              AutomationProperties.Name="{Binding Descriptor.Label}"
                                              Command="{Binding DataContext.ToggleFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="□" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Text" Value="✓" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Descriptor.Label}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12,10,12,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,4,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ObjectCount, StringFormat={}{0:N0} objects}" Foreground="{StaticResource QuietMuted}" FontSize="11" />
                <TextBlock Text="{Binding GroupCount, StringFormat={}{0:N0} layers}" FontSize="11" FontWeight="SemiBold" />
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCurrent}" Value="True"><Setter Property="Height" Value="*" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="*" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsObject}" Value="True"><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Visibility="{Binding HasCurrent, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,10">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Left" Content="‹ Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0" />
                            <Button Content="All layers" Command="{Binding RootCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource QuietButton}" Padding="6,3" MinHeight="26" Margin="0,0,4,4" MaxWidth="220" ToolTip="{Binding Label}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#18232C" BorderBrush="#34434B" BorderThickness="1" CornerRadius="7" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding Current.Label}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Current.Count, StringFormat={}{0:N0} objects}" Foreground="{StaticResource QuietAccent}" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding Current.Fields}"
                                              Visibility="{Binding DataContext.IsObject, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,7">
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource QuietMuted}" />
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" TextWrapping="Wrap" Margin="4,12" Foreground="{StaticResource QuietMuted}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource QuietRow}" Margin="0,0,0,4" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.EnterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource QuietAccent}" Margin="10,0,0,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="{StaticResource QuietMuted}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#141F27" BorderBrush="#2B3B44" BorderThickness="0,1,0,0" Padding="12,10">
            <StackPanel>
                <Grid Visibility="{Binding HasCurrent, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                        <Button Content="‹" Width="30" Padding="0" Style="{StaticResource QuietButton}" Command="{Binding PreviousCommand}" ToolTip="Previous object" AutomationProperties.Name="Previous object" />
                        <TextBlock Text="{Binding ObjectPosition}" VerticalAlignment="Center" Margin="8,0" FontSize="11" Foreground="{StaticResource QuietMuted}" />
                        <Button Content="›" Width="30" Padding="0" Style="{StaticResource QuietButton}" Command="{Binding NextCommand}" ToolTip="Next object" AutomationProperties.Name="Next object" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Focus" MinWidth="92" Style="{StaticResource AccentButton}" Command="{Binding FocusCommand}"
                                ToolTip="Fit and select this group or object. Hidden objects stay hidden; locked viewports are not changed." />
                        <ToggleButton Content="◎" Width="34" Padding="0" Margin="6,0,0,0" Style="{StaticResource QuietToggle}"
                                      IsChecked="{Binding IsAutoFocus}" ToolTip="Auto focus when browsing layers, types, or objects"
                                      AutomationProperties.Name="Auto focus" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="Highlight CAD selection" Command="{Binding EmphasizeCommand}" Style="{StaticResource QuietButton}" Margin="0,0,6,0"
                            ToolTip="Highlight AutoCAD preselected objects and dim the others. Does not zoom or change layers." />
                    <Button Grid.Column="1" Content="Clear highlight" Command="{Binding ClearCommand}" Style="{StaticResource QuietButton}" Padding="8,6" />
                </Grid>
                <TextBlock Text="Temporary · no drawing edits" FontSize="10" Foreground="{StaticResource QuietMuted}" Margin="1,6,0,4" />
                <Grid Height="42" ToolTip="{Binding Status}">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#ADC0C9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource QuietAccent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
