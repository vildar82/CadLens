<UserControl
    x:Class="CadLens.UI.LayersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:CadLens.UI"
    xmlns:lenses="clr-namespace:CadLens.Lenses;assembly=CadLens.Lenses"
    FontFamily="Segoe UI"
    FontSize="12"
    Foreground="#EEF5F8"
    UseLayoutRounding="True"
    d:DataContext="{d:DesignInstance Type=ui:LayersViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="LayersTheme.xaml" />
    </UserControl.Resources>
    <Grid Background="#10171E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Padding="12,9,12,9"
            BorderBrush="#26373F"
            BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#203C3C" />
                    <GradientStop Offset="1" Color="#15212C" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <DockPanel Margin="1,0,1,8">
                    <TextBlock
                        MaxWidth="170"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        FontSize="11"
                        Foreground="{StaticResource QuietMuted}"
                        Text="{Binding SpaceLabel}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SpaceLabel}" />
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Binding LensLabel}" />
                </DockPanel>
                <DockPanel>
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="Refresh active space"
                        Command="{Binding ReadCommand}"
                        Content="↻"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Refresh active space" />
                    <ItemsControl ItemsSource="{Binding Filters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:FilterOption}">
                                <ToggleButton
                                    Margin="0,0,5,0"
                                    Padding="6,4"
                                    AutomationProperties.Name="{Binding Descriptor.Label}"
                                    Command="{Binding DataContext.ToggleFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    FontSize="11"
                                    IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                    Style="{StaticResource ModeToggle}"
                                    ToolTip="{Binding Descriptor.Description}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,4,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="□" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter Property="Text" Value="✓" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Descriptor.Label}" />
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,7">
                <DockPanel Margin="1,2">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <TextBlock
                        DockPanel.Dock="Right"
                        FontSize="11"
                        Foreground="{StaticResource QuietMuted}"
                        Text="{Binding ObjectCount, StringFormat={}{0:N0} objects}" />
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Text="{Binding GroupCount, StringFormat={}{0:N0} layers}" />
                </DockPanel>
                <DockPanel Visibility="{Binding HasCurrent, Converter={StaticResource BooleanVisibility}}">
                    <Button
                        x:Name="BackAction"
                        Width="30"
                        Height="30"
                        Margin="0,0,5,0"
                        Padding="0"
                        AutomationProperties.Name="Back"
                        Command="{Binding BackCommand}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Back">
                        <Path
                            Width="14"
                            Height="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 7,1 L 1,6 L 7,11 M 1,6 L 13,6"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.5" />
                    </Button>
                    <Button
                        Height="30"
                        Margin="0,0,5,0"
                        Padding="7,4"
                        Command="{Binding RootCommand}"
                        Content="All layers"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}" />
                    <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type lenses:LensNode}">
                                <Button
                                    Margin="0,0,3,0"
                                    Padding="5,4"
                                    Command="{Binding DataContext.BreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    FontSize="11"
                                    Style="{StaticResource ModeButton}"
                                    ToolTip="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Margin="0,0,0,6"
                    Padding="9,7"
                    Background="#182730"
                    BorderBrush="#34434B"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasCurrent}" Value="True" />
                                        <Condition Binding="{Binding IsObject}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{Binding Current.Label, FallbackValue=''}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Current.Label, FallbackValue=''}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource QuietAccent}"
                            Text="{Binding Current.Count, FallbackValue='', StringFormat={}{0:N0} objects}" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCurrent}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border
                        Height="30"
                        Margin="0,0,0,5"
                        Background="#182730"
                        BorderBrush="#42545E"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#78E3CE" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel Margin="8,0,3,0">
                            <Path
                                Width="16"
                                Height="16"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Data="M 8,1 A 7,7 0 1 1 7.99,1 M 13,13 L 19,19"
                                DockPanel.Dock="Left"
                                IsHitTestVisible="False"
                                Stretch="Uniform"
                                Stroke="{StaticResource QuietMuted}"
                                StrokeThickness="1.5" />
                            <Button
                                Width="23"
                                Height="23"
                                Padding="0"
                                AutomationProperties.Name="Clear layer search"
                                Command="{Binding ClearSearchCommand}"
                                Content="×"
                                DockPanel.Dock="Right"
                                FontSize="14"
                                ToolTip="Clear layer search">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource ModeButton}" TargetType="Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayerSearch}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Grid>
                                <TextBox
                                    Padding="0"
                                    VerticalContentAlignment="Center"
                                    AutomationProperties.Name="Search layers by name"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CaretBrush="{StaticResource QuietText}"
                                    Foreground="{StaticResource QuietText}"
                                    Text="{Binding LayerSearch, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource QuietMuted}"
                                    IsHitTestVisible="False"
                                    Text="Search layers">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayerSearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LayerSearch}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <DockPanel Grid.Row="1">
                        <ToggleButton
                            MinWidth="78"
                            AutomationProperties.Name="Sort layers by object count"
                            Command="{Binding SortByCountCommand}"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding IsCountSortActive, Mode=OneWay}"
                            Style="{StaticResource ModeSortHeader}"
                            ToolTip="Sort layers by object count">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Objects" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding CountSortArrow}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton
                            AutomationProperties.Name="Sort layers by name"
                            Command="{Binding SortByNameCommand}"
                            DockPanel.Dock="Left"
                            IsChecked="{Binding IsNameSortActive, Mode=OneWay}"
                            Style="{StaticResource ModeSortHeader}"
                            ToolTip="Sort layers by name">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Name" />
                                <TextBlock Margin="4,0,0,0" Text="{Binding NameSortArrow}" />
                            </StackPanel>
                        </ToggleButton>
                    </DockPanel>
                </Grid>
                <TextBlock
                    Grid.Row="2"
                    Margin="2,8"
                    Foreground="{StaticResource QuietMuted}"
                    Text="{Binding EmptyMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibility}}" />
                <ListBox
                    Grid.Row="2"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Items}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsObject}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type lenses:LensNode}">
                            <Button
                                Margin="0,0,0,4"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.EnterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource ModeRow}"
                                ToolTip="{Binding Label}">
                                <DockPanel>
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        Foreground="{StaticResource QuietAccent}"
                                        Text="›" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        DockPanel.Dock="Right"
                                        Foreground="{StaticResource QuietMuted}"
                                        Text="{Binding Count, StringFormat={}{0:N0}}" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer
                    x:Name="ObjectDetails"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                    <Border
                        Padding="9,8"
                        Background="#182730"
                        BorderBrush="#34434B"
                        BorderThickness="1"
                        CornerRadius="5">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,9"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{Binding Current.Label, FallbackValue=''}"
                                TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Current.Fields, FallbackValue={x:Null}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type lenses:DetailField}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Margin="0,0,6,0"
                                                FontSize="11"
                                                Foreground="{StaticResource QuietMuted}"
                                                Text="{Binding Label}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Text="{Binding Value}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border
            Grid.Row="2"
            Padding="12,8,12,8"
            Background="#141F27"
            BorderBrush="#34434B"
            BorderThickness="0,1,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,7" Visibility="{Binding IsObject, Converter={StaticResource BooleanVisibility}}">
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="Previous object"
                        Command="{Binding PreviousCommand}"
                        Content="‹"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Previous object" />
                    <Button
                        Width="28"
                        Padding="0"
                        AutomationProperties.Name="Next object"
                        Command="{Binding NextCommand}"
                        Content="›"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Next object" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource QuietMuted}"
                        Text="{Binding ObjectPosition}" />
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <Button
                        AutomationProperties.Name="Focus camera"
                        Command="{Binding FocusCommand}"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Fit the current layer, type, or object in the active view. Changes the camera only; hidden objects stay hidden.">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="Focus" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="Camera" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Grid.Row="2"
                        Grid.Column="0"
                        MinHeight="26"
                        AutomationProperties.Name="Auto Focus"
                        Command="{Binding ToggleAutoFocusCommand}"
                        IsChecked="{Binding IsAutoFocus, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}"
                        ToolTip="Automatically fit the camera when browsing layers, types, and objects." />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        AutomationProperties.Name="Select CAD objects"
                        Command="{Binding SelectCommand}"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Select the current layer, type, or object in CAD. Keep the camera and temporary isolation unchanged.">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="Select" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="CAD selection" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        Grid.Row="2"
                        Grid.Column="2"
                        MinHeight="26"
                        AutomationProperties.Name="Auto Select"
                        Command="{Binding ToggleAutoSelectCommand}"
                        IsChecked="{Binding IsAutoSelect, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}"
                        ToolTip="Automatically select CAD objects while browsing. Works with Auto Focus off." />
                    <Button
                        Grid.Row="0"
                        Grid.Column="4"
                        AutomationProperties.Name="Isolate temporarily"
                        Command="{Binding IsolateCommand}"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Temporarily hide other active-space objects. Keep the camera and CAD selection unchanged.">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" Text="Isolate" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Style="{StaticResource ModeDescriptor}"
                                Text="Temporary" />
                        </StackPanel>
                    </Button>
                    <ToggleButton
                        x:Name="AutoIsolation"
                        Grid.Row="2"
                        Grid.Column="4"
                        MinHeight="26"
                        AutomationProperties.Name="Auto Isolate"
                        Command="{Binding ToggleAutoIsolationCommand}"
                        IsChecked="{Binding IsAutoIsolation, Mode=OneWay}"
                        Style="{StaticResource ModeAuto}"
                        ToolTip="Automatically hide other active-space objects while browsing. Turning this off restores their display." />
                </Grid>
                <DockPanel Margin="0,7,0,0">
                    <Button
                        x:Name="ResetAction"
                        Padding="10,4"
                        AutomationProperties.Name="Reset selection, isolation, and Auto modes"
                        Command="{Binding ResetCommand}"
                        Content="Reset"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ModeButton}"
                        ToolTip="Clear CAD selection and temporary isolation, turn off all Auto modes, and keep the camera." />
                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{StaticResource QuietMuted}"
                        Text="Auto off · camera kept" />
                </DockPanel>
                <TextBlock
                    Height="28"
                    Margin="1,4,1,0"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="11"
                    Text="{Binding Status}"
                    TextWrapping="Wrap"
                    ToolTip="{Binding Status}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#ADC0C9" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource QuietAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>